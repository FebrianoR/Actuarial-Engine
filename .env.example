# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME="Actuarial Engine"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ─── Server ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ─── Security ────────────────────────────────────────────────
# Ganti dengan secret yang kuat di production
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=http://localhost:3000,https://*.ngrok-free.app,https://*.ngrok.io,https://*.up.railway.app

# ─── Aktuaria ────────────────────────────────────────────────
# Path default file asumsi (di dalam container)
DEFAULT_ASSUMPTIONS_PATH=/app/data/assumptions/base_assumptions.json
PORTFOLIO_DATA_PATH=/app/data/sample_portfolios/

# ─── Audit ───────────────────────────────────────────────────
AUDIT_LOG_PATH=/app/audit_logs/
AUDIT_ENABLED=true

# ─── Perhitungan ─────────────────────────────────────────────
# Jumlah simulasi untuk Risk Adjustment (Monte Carlo)
RA_SIMULATION_COUNT=10000
# Tahun proyeksi maksimum
MAX_PROJECTION_YEARS=30
